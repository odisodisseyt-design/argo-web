# Base URL of the existing ARGO backend (HTTP API). Example: https://api.argo.example
VITE_API_URL=

# Base URL for WebSocket connections. Example: wss://api.argo.example
# The campaign socket is opened at `${VITE_WS_URL}/api/campaign/{id}/ws`.
VITE_WS_URL=

# Leave both empty to run the client only in the clearly marked demo mode.
# Never put secrets here: every VITE_* variable is embedded in the public bundle.
